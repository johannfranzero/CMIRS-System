# =============================================================================
# CMIRS — Environment Variables
# =============================================================================
# Copy this file to .env.local and replace placeholder values with your
# actual credentials. NEVER commit .env.local or any file containing real
# credentials. The .gitignore already excludes .env* files.
#
# These variables are defined for the planned Supabase integration.
# No application code currently consumes them.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase — Client-Side (Public)
# ---------------------------------------------------------------------------
# These variables are prefixed with NEXT_PUBLIC_ and are exposed to the
# browser. They use the Supabase anon (public) key, which is safe to expose
# because Row Level Security (RLS) policies control data access.

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here

# Your Supabase publishable (anon/public) key — safe for client-side use with RLS enabled
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# ---------------------------------------------------------------------------
# Supabase — Server-Side Only (Secret)
# ---------------------------------------------------------------------------
# Uncomment the following variable ONLY if a genuine server-side use case is
# established (e.g., admin operations, background jobs, or webhook handlers
# that require bypassing RLS). This key must NEVER be exposed to the client.
#
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ---------------------------------------------------------------------------
# Development-Only Tooling
# ---------------------------------------------------------------------------
# CMIRS_ENABLE_TEST_PERSONAS=true enables the QA test-persona quick-fill panel
# on the login page. It is honoured ONLY when NODE_ENV === 'development'
# (i.e. `next dev`). A production build always sets NODE_ENV=production, so
# the panel is removed from production bundles regardless of this setting.
#
# The variable is intentionally NOT prefixed with NEXT_PUBLIC_, so it is never
# inlined into the browser bundle.
#
# CMIRS_ENABLE_TEST_PERSONAS=true
